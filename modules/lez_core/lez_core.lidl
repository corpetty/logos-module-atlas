module lez_core {
  version "0.5.0"
  description "Logos Execution Zone Core Module for Logos Core"
  category "blockchain"
  depends []

  method name() -> tstr
  method version() -> tstr
  method wallet_dir() -> tstr
  method create_new(config_path: tstr, storage_path: tstr, statistics_path: tstr, password: tstr) -> tstr
  method open(config_path: tstr, storage_path: tstr, statistics_path: tstr) -> int
  method save() -> int
  method restore_storage(mnemonic: tstr, password: tstr, depth: any) -> int
  method create_account_public() -> tstr
  method create_account_private() -> tstr
  method list_accounts() -> [any]
  method get_balance(account_id_hex: tstr, is_public: bool) -> tstr
  method get_account_public(account_id_hex: tstr) -> tstr
  method get_account_private(account_id_hex: tstr) -> tstr
  method get_public_account_key(account_id_hex: tstr) -> tstr
  method get_private_account_keys(account_id_hex: tstr) -> tstr
  method account_id_to_base58(account_id_hex: tstr) -> tstr
  method account_id_from_base58(base58_str: tstr) -> tstr
  method sync_to_block(block_id: int) -> int
  method get_last_synced_block() -> int
  method get_current_block_height() -> int
  method transfer_public(from_hex: tstr, to_hex: tstr, amount_le16_hex: tstr) -> tstr
  method transfer_shielded(from_hex: tstr, to_keys_json: tstr, amount_le16_hex: tstr) -> tstr
  method transfer_deshielded(from_hex: tstr, to_hex: tstr, amount_le16_hex: tstr) -> tstr
  method transfer_private(from_hex: tstr, to_keys_json: tstr, amount_le16_hex: tstr) -> tstr
  method transfer_shielded_owned(from_hex: tstr, to_hex: tstr, amount_le16_hex: tstr) -> tstr
  method transfer_private_owned(from_hex: tstr, to_hex: tstr, amount_le16_hex: tstr) -> tstr
  method token_elf() -> bstr
  method amm_elf() -> bstr
  method ata_elf() -> bstr
  method send_generic_public_transaction(account_ids: [tstr], signing_requirements: [bool], instruction: bstr, program_id_hex: tstr, payer_account_id_hex: tstr, shard_program_account_ids_hex: [tstr]) -> tstr
  method send_generic_private_transaction(account_ids: [tstr], instruction: bstr, program_elf: bstr, program_kind_json: tstr, program_dependencies: any, dependency_kinds_json: [tstr], shard_program_account_ids_hex: [tstr]) -> tstr
  method send_program_deployment_transaction(header_account_id_hex: tstr, segment_account_ids_hex: [tstr], program_elf: bstr, immutable: bool, payer_account_id_hex: tstr) -> tstr
  method poll_transaction_status(tx_hash_hex: tstr) -> bool
  method bridge_withdraw(from_hex: tstr, bedrock_account_pk_hex: tstr, amount: uint) -> tstr
  method get_sequencer_addr() -> tstr
  method check_label_available(label: tstr) -> bool
  method add_label(label: tstr, account_id_hex: tstr, is_private: bool) -> int
  method resolve_label(label: tstr) -> tstr
  method get_all_labels_for_account(account_id_hex: tstr, is_private: bool) -> [tstr]
}
