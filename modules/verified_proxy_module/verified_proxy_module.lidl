module verified_proxy_module {
  version "0.1.3"
  description "Light-client-verified Ethereum JSON-RPC, wrapping nimbus libverifproxy"
  category "wallet"
  depends []

  method configure(config: {tstr: any}) -> result description "Validate and store the proxy configuration. Synchronous; starts nothing.\n\nRequired: `trustedBlockRoot` (0x + 64 hex), `executionApiUrls` and\n`beaconApiUrls` (arrays of http/https/ws/wss URLs). The provider must\nsupport `eth_getProof`.\n\n`network` is one of mainnet, sepolia, hoodi — enforced here, because an\nunrecognised value reaches a `quit()` inside the library and would take\nthe whole host process down. `logLevel` is whitelisted for the same\nreason. OP-Stack L2 is enabled by setting `opExecutionApiUrls`.\n\n@code{.json}\n{\n\"network\": \"mainnet\",\n\"trustedBlockRoot\": \"0x...\",\n\"executionApiUrls\": [\"wss://...\"],\n\"beaconApiUrls\": [\"https://...\"],\n\"opExecutionApiUrls\": [], \"privateTxUrls\": [], \"archiveUrls\": [],\n\"logLevel\": \"INFO\", \"logFormat\": \"Json\",\n\"tuning\": { \"maxBlockWalk\": 1000, \"headerStoreLen\": 256 },\n\"callTimeoutMs\": 30000, \"queueTimeoutMs\": 30000,\n\"startTimeoutMs\": 120000,\n\"keepAlive\": \"interval\", \"keepAliveIntervalMs\": 12000,  // do not use \"off\",\n// raised to 12000 if lower\n\"httpServer\": { \"enabled\": false, \"host\": \"127.0.0.1\", \"port\": 8545 },\n\"maxInFlight\": 64, \"autoStart\": false\n}\n@endcode\n\nReturns success, or a specific message naming the offending field."
  method getConfig() -> {tstr: any} description "The effective configuration with defaults merged in and provider\ncredentials redacted. Returns an empty object if configure() has not run."
  method getConfigUnredacted() -> {tstr: any} description "The same configuration WITHOUT redaction, for restoring a form.\n\nconfigure() persists what it accepts, and onContextReady() reloads it,\nso the module already remembers the last working setup across restarts.\nA UI repopulating its fields needs the real URLs, which getConfig()\ndeliberately masks because provider endpoints can carry API keys.\n\nReturns an empty object if configure() has not run. Treat the result as\na credential: do not log it, and prefer getConfig() anywhere the values\nare only being displayed."
  method defaultConfig(network: tstr) -> {tstr: any} description "A complete, ready-to-submit configuration for `network`, with this\nmodule's defaults filled in — the endpoint pair from the network table\nplus every tuning and timeout default.\n\nIntended for bootstrapping from a CLI:\n\nlogosctl call verified_proxy_module defaultConfig mainnet\n\ngives a template to edit. `trustedBlockRoot` is deliberately left EMPTY\n— it anchors the entire trust model and cannot be defaulted; fetch one\nwith fetchFinalizedRoot() or supply one you already trust.\n\nReturns an empty object for an unsupported network."
  method start() -> result description "Start the proxy and wait for the light client to initialise.\n\nBlocks up to `startTimeoutMs`. On success the result value carries the\nchain id. Also emits `proxyStarted`."
  method stop() -> result description "Stop the proxy: drain in-flight calls, then release the context.\n\n`drainTimeoutMs` (default 2000) bounds when the drain stops STARTING new\nturns of the library's task pump — not when this returns. The deadline is\nchecked between calls into the library, and one such call was measured\nblocking for up to 3.3s, so budget `drainTimeoutMs` plus up to one pump\nduration. Bounded, but not tight: a measured stop() took 1102ms.\n\nCallers still blocked in an RPC call are released with\n\"proxy shutting down\" rather than waiting out their own timeout.\n\nAlso emits `proxyStopped`."
  method ok() -> bool description "True when the proxy is running: neither the sync nor the heartbeat has\nfailed three times in a row."
  method status() -> {tstr: any} description "Module and proxy state. Never blocks on the proxy thread.\n\n@code{.json}\n{\n\"state\": \"uninitialized|configured|starting|running|degraded|stopping|stopped|error\",\n\"network\": string, \"chainId\": number,\n\"startedAt\": number, \"uptimeSeconds\": number,\n\"head\": { \"blockNumber\": string, \"updatedAt\": number },\n\"sync\": { \"intervalMs\": number, \"lastSyncedAt\": number,\n\"failures\": number, \"consecutiveFailures\": number,\n\"lastError\": string },\n\"counters\": { \"callsTotal\": number, \"callsFailed\": number,\n\"callsInFlight\": number, \"callsAdmitted\": number,\n\"leakedCalls\": number, \"heartbeatFailures\": number,\n\"resourceRejections\": number,\n\"callsQueued\": number, \"queueTimeouts\": number },\n\"resources\": { \"openDescriptors\": number,\n\"softDescriptorLimit\": number,\n\"descriptorReserve\": number,\n\"estimatedDescriptorsPerCall\": number,\n\"configuredMaxInFlight\": number,\n\"effectiveMaxInFlight\": number,\n\"queuedCalls\": number, \"queueTimeoutMs\": number },\n\"lastError\": string\n}\n@endcode"
  method moduleVersion() -> tstr description "This module's version, as declared in metadata.json."
  method libraryVersion() -> tstr description "The nimbus-eth1 revision this module was built against."
  method localEndpoint() -> tstr description "URL of this module's own JSON-RPC endpoint, or \"\" when it is not\nrunning (`httpServer.enabled` defaults to false).\n\nThis is the integration seam for anything that speaks plain JSON-RPC:\nhand it to `eth_rpc_module`'s `ChainConfig.endpoint`, or to ethers /\nviem / cast, and their reads become light-client-verified without any\nof them knowing this module exists.\n\nNote the library itself ships no server — `libverifproxy` never imports\n`json_rpc_frontend`, and its symbols are absent from the archive. This\nendpoint is the module's, forwarding to the same verified `proxyCall`\npath the typed methods use."
  method supportedNetworks() -> [any] description "The networks this module accepts, each with its chain id and a\nsuggested public endpoint pair.\n\nA UI should build its network selector from THIS rather than hardcoding\na list: `network` is one of exactly two config fields whose value\nreaches a `quit()` inside the Nim library when upstream does not\nrecognise it, taking the whole host process down, so a UI list that\ndrifts from the module's whitelist is a crash waiting to happen.\n\nReturns a list of `{\"name\", \"chainId\", \"beaconApiUrl\",\n\"executionApiUrl\"}`. The two URLs are a convenience for prefilling a\nform and may be EMPTY, which means no public endpoint is known to meet\nthe requirements for that network — a beacon endpoint has to serve the\nlight-client REST API and an execution endpoint has to support\n`eth_getProof`. Empty is deliberate: a plausible URL that cannot\nactually verify is worse than none, because it fails long after the\nchoice that caused it."
  method fetchFinalizedRoot(beaconUrl: tstr) -> result description "Fetch the current finalized beacon block root from `beaconUrl`.\n\nA convenience for operators who have no root to hand: it queries\n`<beaconUrl>/eth/v1/beacon/headers/finalized` and returns\n`{\"root\": \"0x…\", \"slot\": \"…\"}`. Takes the URL as an argument rather\nthan reading the stored config so it is usable before configure().\n\nThis is deliberately NOT part of the trust model. A root fetched from\nthe same endpoint you are about to distrust anchors nothing — it is a\nstarting point for testing, and an operator running against real value\nshould take the root from a source they independently trust and paste\nit in. The method lives here rather than in a UI because Basecamp\nsandboxes `ui_qml` plugins away from the network entirely; a core\nmodule is the only component allowed to make the request."
  method rpc(method: tstr, params: [any]) -> result description "Any method the proxy supports, dispatched through the library's own\n`proxyCall`. `params` is a JSON-RPC params array.\n\nNote that `eth_call`, `eth_estimateGas` and `eth_createAccessList` take\na THIRD positional parameter, `optimisticStateFetch` (a bool) — an\nupstream extension to the standard JSON-RPC signature. The typed\nwrappers below supply it for you.\n\nReturns the decoded result value on success."
  method ethChainId() -> result description "`eth_chainId`, verified."
  method ethBlockNumber() -> result description "`eth_blockNumber`, verified."
  method ethGetBalance(address: tstr, blockTag: tstr) -> result description "`eth_getBalance`, verified."
  method ethGetStorageAt(address: tstr, slot: tstr, blockTag: tstr) -> result description "`eth_getStorageAt`, verified."
  method ethGetTransactionCount(address: tstr, blockTag: tstr) -> result description "`eth_getTransactionCount`, verified."
  method ethGetCode(address: tstr, blockTag: tstr) -> result description "`eth_getCode`, verified."
  method ethGetBlockByHash(blockHash: tstr, fullTransactions: bool) -> result description "`eth_getBlockByHash`, verified."
  method ethGetBlockByNumber(blockTag: tstr, fullTransactions: bool) -> result description "`eth_getBlockByNumber`, verified."
  method ethGetUncleCountByBlockNumber(blockTag: tstr) -> result description "`eth_getUncleCountByBlockNumber`, verified."
  method ethGetUncleCountByBlockHash(blockHash: tstr) -> result description "`eth_getUncleCountByBlockHash`, verified."
  method ethGetBlockTransactionCountByNumber(blockTag: tstr) -> result description "`eth_getBlockTransactionCountByNumber`, verified."
  method ethGetBlockTransactionCountByHash(blockHash: tstr) -> result description "`eth_getBlockTransactionCountByHash`, verified."
  method ethGetTransactionByBlockNumberAndIndex(blockTag: tstr, index: uint) -> result description "`eth_getTransactionByBlockNumberAndIndex`, verified."
  method ethGetTransactionByBlockHashAndIndex(blockHash: tstr, index: uint) -> result description "`eth_getTransactionByBlockHashAndIndex`, verified."
  method ethCall(txArgs: {tstr: any}, blockTag: tstr, optimisticStateFetch: bool) -> result description "`eth_call`, verified.\n\n`optimisticStateFetch` is upstream's own extension to the standard\nJSON-RPC signature, not a parameter callers will know from elsewhere."
  method ethCreateAccessList(txArgs: {tstr: any}, blockTag: tstr, optimisticStateFetch: bool) -> result description "`eth_createAccessList`, verified.\n\n`optimisticStateFetch` is upstream's own extension to the standard\nJSON-RPC signature, not a parameter callers will know from elsewhere."
  method ethEstimateGas(txArgs: {tstr: any}, blockTag: tstr, optimisticStateFetch: bool) -> result description "`eth_estimateGas`, verified.\n\n`optimisticStateFetch` is upstream's own extension to the standard\nJSON-RPC signature, not a parameter callers will know from elsewhere."
  method ethGetTransactionByHash(txHash: tstr) -> result description "`eth_getTransactionByHash`, verified."
  method ethGetBlockReceipts(blockTag: tstr) -> result description "`eth_getBlockReceipts`, verified."
  method ethGetTransactionReceipt(txHash: tstr) -> result description "`eth_getTransactionReceipt`, verified."
  method ethGetLogs(filterOptions: {tstr: any}) -> result description "`eth_getLogs`, verified."
  method ethNewFilter(filterOptions: {tstr: any}) -> result description "`eth_newFilter`, verified."
  method ethUninstallFilter(filterId: tstr) -> result description "`eth_uninstallFilter`, verified."
  method ethGetFilterLogs(filterId: tstr) -> result description "`eth_getFilterLogs`, verified."
  method ethGetFilterChanges(filterId: tstr) -> result description "`eth_getFilterChanges`, verified."
  method ethBlobBaseFee() -> result description "`eth_blobBaseFee`, verified."
  method ethGasPrice() -> result description "`eth_gasPrice`, verified."
  method ethMaxPriorityFeePerGas() -> result description "`eth_maxPriorityFeePerGas`, verified."
  method ethFeeHistory(blockCount: uint, newestBlock: tstr, rewardPercentiles: [any]) -> result description "`eth_feeHistory`, verified."
  method ethSendRawTransaction(txHexBytes: tstr) -> result description "`eth_sendRawTransaction`, verified."
  method opChainId() -> result description "`op_chainId`, verified.\n\nRequires an OP-Stack network and `opExecutionApiUrls`; otherwise the\nlibrary answers with a clear error rather than a wrong value."
  method opBlockNumber() -> result description "`op_blockNumber`, verified.\n\nRequires an OP-Stack network and `opExecutionApiUrls`; otherwise the\nlibrary answers with a clear error rather than a wrong value."
  method opGetBalance(address: tstr, blockTag: tstr) -> result description "`op_getBalance`, verified.\n\nRequires an OP-Stack network and `opExecutionApiUrls`; otherwise the\nlibrary answers with a clear error rather than a wrong value."
  method opGetStorageAt(address: tstr, slot: tstr, blockTag: tstr) -> result description "`op_getStorageAt`, verified.\n\nRequires an OP-Stack network and `opExecutionApiUrls`; otherwise the\nlibrary answers with a clear error rather than a wrong value."
  method opGetTransactionCount(address: tstr, blockTag: tstr) -> result description "`op_getTransactionCount`, verified.\n\nRequires an OP-Stack network and `opExecutionApiUrls`; otherwise the\nlibrary answers with a clear error rather than a wrong value."
  method opGetCode(address: tstr, blockTag: tstr) -> result description "`op_getCode`, verified.\n\nRequires an OP-Stack network and `opExecutionApiUrls`; otherwise the\nlibrary answers with a clear error rather than a wrong value."
  method opGetBlockByHash(blockHash: tstr, fullTransactions: bool) -> result description "`op_getBlockByHash`, verified.\n\nRequires an OP-Stack network and `opExecutionApiUrls`; otherwise the\nlibrary answers with a clear error rather than a wrong value."
  method opGetBlockByNumber(blockTag: tstr, fullTransactions: bool) -> result description "`op_getBlockByNumber`, verified.\n\nRequires an OP-Stack network and `opExecutionApiUrls`; otherwise the\nlibrary answers with a clear error rather than a wrong value."
  method opGetUncleCountByBlockNumber(blockTag: tstr) -> result description "`op_getUncleCountByBlockNumber`, verified.\n\nRequires an OP-Stack network and `opExecutionApiUrls`; otherwise the\nlibrary answers with a clear error rather than a wrong value."
  method opGetUncleCountByBlockHash(blockHash: tstr) -> result description "`op_getUncleCountByBlockHash`, verified.\n\nRequires an OP-Stack network and `opExecutionApiUrls`; otherwise the\nlibrary answers with a clear error rather than a wrong value."
  method opGetBlockTransactionCountByNumber(blockTag: tstr) -> result description "`op_getBlockTransactionCountByNumber`, verified.\n\nRequires an OP-Stack network and `opExecutionApiUrls`; otherwise the\nlibrary answers with a clear error rather than a wrong value."
  method opGetBlockTransactionCountByHash(blockHash: tstr) -> result description "`op_getBlockTransactionCountByHash`, verified.\n\nRequires an OP-Stack network and `opExecutionApiUrls`; otherwise the\nlibrary answers with a clear error rather than a wrong value."
  method opGetTransactionByBlockNumberAndIndex(blockTag: tstr, index: uint) -> result description "`op_getTransactionByBlockNumberAndIndex`, verified.\n\nRequires an OP-Stack network and `opExecutionApiUrls`; otherwise the\nlibrary answers with a clear error rather than a wrong value."
  method opGetTransactionByBlockHashAndIndex(blockHash: tstr, index: uint) -> result description "`op_getTransactionByBlockHashAndIndex`, verified.\n\nRequires an OP-Stack network and `opExecutionApiUrls`; otherwise the\nlibrary answers with a clear error rather than a wrong value."
  method opCall(txArgs: {tstr: any}, blockTag: tstr, optimisticStateFetch: bool) -> result description "`op_call`, verified.\n\n`optimisticStateFetch` is upstream's own extension to the standard\nJSON-RPC signature, not a parameter callers will know from elsewhere.\n\nRequires an OP-Stack network and `opExecutionApiUrls`; otherwise the\nlibrary answers with a clear error rather than a wrong value."
  method opCreateAccessList(txArgs: {tstr: any}, blockTag: tstr, optimisticStateFetch: bool) -> result description "`op_createAccessList`, verified.\n\n`optimisticStateFetch` is upstream's own extension to the standard\nJSON-RPC signature, not a parameter callers will know from elsewhere.\n\nRequires an OP-Stack network and `opExecutionApiUrls`; otherwise the\nlibrary answers with a clear error rather than a wrong value."
  method opEstimateGas(txArgs: {tstr: any}, blockTag: tstr, optimisticStateFetch: bool) -> result description "`op_estimateGas`, verified.\n\n`optimisticStateFetch` is upstream's own extension to the standard\nJSON-RPC signature, not a parameter callers will know from elsewhere.\n\nRequires an OP-Stack network and `opExecutionApiUrls`; otherwise the\nlibrary answers with a clear error rather than a wrong value."
  method opGetTransactionByHash(txHash: tstr) -> result description "`op_getTransactionByHash`, verified.\n\nRequires an OP-Stack network and `opExecutionApiUrls`; otherwise the\nlibrary answers with a clear error rather than a wrong value."
  method opGetBlockReceipts(blockTag: tstr) -> result description "`op_getBlockReceipts`, verified.\n\nRequires an OP-Stack network and `opExecutionApiUrls`; otherwise the\nlibrary answers with a clear error rather than a wrong value."
  method opGetTransactionReceipt(txHash: tstr) -> result description "`op_getTransactionReceipt`, verified.\n\nRequires an OP-Stack network and `opExecutionApiUrls`; otherwise the\nlibrary answers with a clear error rather than a wrong value."
  method opGetLogs(filterOptions: {tstr: any}) -> result description "`op_getLogs`, verified.\n\nRequires an OP-Stack network and `opExecutionApiUrls`; otherwise the\nlibrary answers with a clear error rather than a wrong value."
  method opNewFilter(filterOptions: {tstr: any}) -> result description "`op_newFilter`, verified.\n\nRequires an OP-Stack network and `opExecutionApiUrls`; otherwise the\nlibrary answers with a clear error rather than a wrong value."
  method opUninstallFilter(filterId: tstr) -> result description "`op_uninstallFilter`, verified.\n\nRequires an OP-Stack network and `opExecutionApiUrls`; otherwise the\nlibrary answers with a clear error rather than a wrong value."
  method opGetFilterLogs(filterId: tstr) -> result description "`op_getFilterLogs`, verified.\n\nRequires an OP-Stack network and `opExecutionApiUrls`; otherwise the\nlibrary answers with a clear error rather than a wrong value."
  method opGetFilterChanges(filterId: tstr) -> result description "`op_getFilterChanges`, verified.\n\nRequires an OP-Stack network and `opExecutionApiUrls`; otherwise the\nlibrary answers with a clear error rather than a wrong value."
  method opBlobBaseFee() -> result description "`op_blobBaseFee`, verified.\n\nRequires an OP-Stack network and `opExecutionApiUrls`; otherwise the\nlibrary answers with a clear error rather than a wrong value."
  method opGasPrice() -> result description "`op_gasPrice`, verified.\n\nRequires an OP-Stack network and `opExecutionApiUrls`; otherwise the\nlibrary answers with a clear error rather than a wrong value."
  method opMaxPriorityFeePerGas() -> result description "`op_maxPriorityFeePerGas`, verified.\n\nRequires an OP-Stack network and `opExecutionApiUrls`; otherwise the\nlibrary answers with a clear error rather than a wrong value."
  method opFeeHistory(blockCount: uint, newestBlock: tstr, rewardPercentiles: [any]) -> result description "`op_feeHistory`, verified.\n\nRequires an OP-Stack network and `opExecutionApiUrls`; otherwise the\nlibrary answers with a clear error rather than a wrong value."
  method opSendRawTransaction(txHexBytes: tstr) -> result description "`op_sendRawTransaction`, verified.\n\nRequires an OP-Stack network and `opExecutionApiUrls`; otherwise the\nlibrary answers with a clear error rather than a wrong value."

  event proxyStarted(payload: tstr) description "Emitted when start() finishes. {\"success\":bool,\"chainId\":number,\"error\":string}"
  event proxyStopped(payload: tstr) description "Emitted when stop() finishes. {\"success\":bool}"
  event proxyStateChanged(payload: tstr) description "Emitted on every proxy state transition.\n{\"state\":string,\"previous\":string,\"error\":string}"
}
