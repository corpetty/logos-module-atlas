module evm_keystore_cli {
  version "0.1.0"
  depends []

  method status() -> tstr description "`{ ok, held, identity, approvers, custodians, hint }`."
  method create_mnemonic(words: int) -> tstr
  method import_mnemonic(params_json: tstr) -> tstr
  method derive_next_account(params_json: tstr) -> tstr
  method derive_account_at(params_json: tstr) -> tstr
  method preview_addresses(params_json: tstr) -> tstr
  method create_unrelated_account(params_json: tstr) -> tstr
  method forget_derivation(params_json: tstr) -> tstr
  method remove_group(params_json: tstr) -> tstr
  method settle() -> tstr
  method remove_unexplained(params_json: tstr) -> tstr
  method set_group_label(params_json: tstr) -> tstr
  method import_private_key(priv_hex: tstr, password: tstr) -> tstr
  method import_keystore_json(key_json: tstr, password: tstr, new_password: tstr) -> tstr
  method export_keystore_json(address: tstr, password: tstr) -> tstr
  method delete_account(address: tstr, password: tstr) -> tstr description "`{ ok }` rather than the keystore's bare bool, so a refusal can say why."
  method change_password(address: tstr, old_password: tstr, new_password: tstr) -> tstr
  method set_label(address: tstr, label: tstr, password: tstr) -> tstr
  method list_accounts() -> tstr
  method get_labels() -> tstr
  method get_group_labels() -> tstr
  method list_groups() -> tstr
  method list_derivation_keys() -> tstr
  method get_provenance() -> tstr
  method caller_identity() -> tstr
}
