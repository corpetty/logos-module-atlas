module uniswap_module {
  version "0.1.0"
  depends []

  method configure(chain_json: tstr) -> bool description "Add or override a chain's Uniswap config (JSON of `ChainUniswap`)."
  method get_chains() -> tstr description "All configured chains (defaults + overrides)."
  method get_prices(chain_id: int, tokens_json: tstr) -> tstr description "Token→ETH and token→USD prices for `{ \"tokens\": [{address, decimals}] }`,\nbest-rate across V2/V3/V4, batched into one Multicall3 `eth_call`."
  method quote_swap(chain_id: int, params_json: tstr) -> tstr description "Best swap quote for `{ tokenIn, tokenOut, amountIn, owner? }` (native = \"ETH\"):\nthe route, its output, the price impact, a gas hint, and — with `owner` — the\naccount's balance and whether an approval must go first."
  method build_swap(chain_id: int, params_json: tstr) -> tstr description "The quote plus the calls that make the swap, in order, in the shape\n`tx_sender_module` takes: `{ calls: [{ kind, to, value, data, gasLimitHint, label }] }`."
}
